        "Tutor NPC greets player",
        "Show progress 0%",
        "Show one clear Day 1 goal",
        "Start button"
      ]
    },
    {
      "step": 2,
      "id": "tutor_lesson",
      "name": "Tutor Lesson",
      "gameRole": "Teach today's one topic",
      "sharedActions": [
        "Tutor demonstrates with visual objects/NPC dialogue",
        "Play native audio",
        "Show only the minimum explanation needed",
        "Let player interact after each concept"
      ]
    },
    {
      "step": 3,
      "id": "daily_vocabulary",
      "name": "Daily Vocabulary",
      "gameRole": "Build today's vocabulary through interaction",
      "sharedActions": [
        "Show track-specific words",
        "Each word uses See -> Hear -> Meaning -> Example -> Use",
        "Avoid random word memorization",
        "Mark each mastered word"
      ]
    },
    {
      "step": 4,
      "id": "hunt_game",
      "name": "Game 1: Hunt",
      "gameRole": "Explore and find target letters/words/meanings",
