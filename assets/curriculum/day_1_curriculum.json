          "Hi.",
          "My name is ___."
        ],
        "middle": [
          "Hi! My name is ___. Where are you from?"
        ],
        "higher": [
          "Hi! I'm ___. What are you currently working on?"
        ]
      }
    },
    {
      "step": 9,
      "id": "community_mission",
      "name": "Community English Mission",
      "gameRole": "Use English publicly in a safe, simple task",
      "mechanics": [
        "Open English community",
        "Post one track-specific message",
        "Optional reply to another learner",
        "Mark mission complete"
      ]
    },
    {
      "step": 10,
      "id": "attack_and_home_defense",
      "name": "Attack + Home Defense",
      "gameRole": "Turn learned English into game progression",
      "mechanics": [
        "Player enters training attack",
        "Today's questions cause attack damage",
        "Player installs/updates learned defense questions",
        "Correct answer = successful attack/defense",
        "Wrong answer = retry with hint",
        "Show reward"
      ]
    }
