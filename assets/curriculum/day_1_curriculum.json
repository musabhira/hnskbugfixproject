        "2D movement",
        "Target highlighting",
        "Object interaction",
        "Collect target",
        "Immediate feedback",
        "XP reward"
      ]
    },
    {
      "step": 5,
      "id": "match_build_game",
      "name": "Game 2: Match + Build",
      "gameRole": "Convert recognition into active use",
      "mechanics": [
        "Match object to word",
        "Arrange letters",
        "Arrange words",
        "Build sentence",
        "Upgrade sentence for higher track"
      ]
    },
    {
      "step": 6,
      "id": "reading_listening",
      "name": "Reading + Listening Room",
      "gameRole": "Understand simple English and hear correct pronunciation",
      "mechanics": [
        "Short content",
        "Native audio",
        "Tap-to-hear",
        "Read aloud option",
        "1-3 comprehension questions"
      ]
    },
    {
      "step": 7,
      "id": "spoken_lab",
      "name": "Speaking Mission",
      "gameRole": "Make player say today's English",
      "mechanics": [
        "Tutor plays model audio",
        "Player repeats or answers",
        "Voice recording where enabled",
        "Basic feedback",
        "Complete 3-6 short speaking tasks"
      ]
    },
    {
      "step": 8,
      "id": "social_practice",
      "name": "Mate Practice",
      "gameRole": "Move learned English into real communication",
      "mechanics": [
        "Random partner option",
        "PocketTalk/Mate request option",
        "Provide starter prompts matched to track",
        "Reward completion, not perfection"
      ],
      "track_examples": {
