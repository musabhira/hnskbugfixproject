{
  "hosting": {
    "public": "web_portal/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/privacy-policy.html",
        "destination": "/privacy-policy.html"
      },
      {
        "source": "/terms-of-service.html",
        "destination": "/terms-of-service.html"
      },
      {
        "source": "/support-help.html",
        "destination": "/support-help.html"
      },
      {
        "source": "/safety-standards.html",
        "destination": "/safety-standards.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}